  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.61.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.0.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.2",
    "playwright-bdd": "^9.2.0",
    "typescript": "^5.6.3",
    "yaml": "^2.6.1"
  },
  "dependencies": {
    "sqlite3": "^5.1.6"
  }
