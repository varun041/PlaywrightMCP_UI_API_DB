{
  "name": "playwright_api_db_ui_ai",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "node scripts/run-with-allure.js",
    "test:smoke": "node scripts/run-with-allure.js --grep @Smoke",
    "test:regression": "node scripts/run-with-allure.js --grep @Regression --grep-invert @KnownGap",
    "test:known-gaps": "node scripts/run-with-allure.js --grep @KnownGap",
    "test:security": "node scripts/run-with-allure.js --grep @Security",
    "test:accessibility": "node scripts/run-with-allure.js --grep @Accessibility",
    "test:performance": "node scripts/run-with-allure.js --grep @PerformanceSmoke",
    "test:ui": "node scripts/run-with-allure.js --grep @UI",
    "test:FirstCase": "node scripts/run-with-allure.js --grep @FirstCase",
    "test:api": "node scripts/run-with-allure.js --grep @API",
    "test:db": "node scripts/run-with-allure.js --grep @DB",
    "test:report": "playwright show-report reports/html",
    "allure:report": "allure generate reports/allure-results --clean -o reports/allure && allure open reports/allure",
    "bdd:gen": "bddgen",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
