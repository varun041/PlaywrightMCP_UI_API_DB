{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@pages/*": ["src/pages/*"],
      "@modals/*": ["src/modals/*"],
      "@components/*": ["src/components/*"],
      "@widgets/*": ["src/widgets/*"],
      "@controls/*": ["src/controls/*"],
      "@navigation/*": ["src/navigation/*"],
      "@services/*": ["src/services/*"],
      "@utils/*": ["src/utils/*"],
      "@assertions/*": ["src/assertions/*"],
      "@fixtures/*": ["src/fixtures/*"],
      "@enums/*": ["src/enums/*"],
      "@constants/*": ["src/constants/*"],
      "@app-types/*": ["src/types/*"],
      "@config/*": ["config/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "config/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "banking-app", "dist", "tests/.features-gen"]
}
